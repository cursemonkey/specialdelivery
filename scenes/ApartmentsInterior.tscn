[gd_scene load_steps=2 format=3 uid="uid://apartmentsinterior"]

[ext_resource type="Script" path="res://scripts/HomeInterior.gd" id="1"]

; Apartment 301 on the third floor — the flat the player can buy. Its only door
; is in the south wall, back out to the Floor 3 hallway; there is no street
; exit (that's in the lobby). See InteriorRegistry._register_apartments().
[node name="ApartmentsInterior" type="Node2D"]
script = ExtResource("1")

; Assign the room art to this Sprite2D. Keep centered = false and leave the
; position at (0, 0) so the art's top-left corner is the room's origin.
[node name="Background" type="Sprite2D" parent="."]
texture_filter = 1
position = Vector2(0, 0)
centered = false

; Draw CollisionPolygon2D children in here, over the walls and furniture.
[node name="Walls" type="StaticBody2D" parent="."]

; Once there is art, add an Area2D "Door_Apartments_F3" over the doorway to
; the hallway and a Marker2D "Spawn_Apartments_F3" just inside it — see
; Interior.gd. Without them they are generated to fit the procedural room.

; Where the player appears when the day starts here — just inside the doorway.
[node name="PlayerSpawn" type="Marker2D" parent="."]
position = Vector2(280.0, 334)

; E-to-sleep is measured from here, so put it on the bed in the art.
[node name="Bed" type="Marker2D" parent="."]
position = Vector2(280.0, 49)

; Optional: Marker2D children here place visiting villagers.
[node name="NPCSpots" type="Node2D" parent="."]

[node name="Spot1" type="Marker2D" parent="NPCSpots"]
position = Vector2(184, 171)

[node name="Spot2" type="Marker2D" parent="NPCSpots"]
position = Vector2(375, 171)

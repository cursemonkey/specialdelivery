[gd_scene load_steps=2 format=3 uid="uid://hud"]

[ext_resource type="Script" path="res://scripts/HUD.gd" id="1"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 0
offset_right = 180
offset_bottom = 90

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2

[node name="Title" type="Label" parent="Panel/VBox"]
text = "📦 Cozy Delivery Co."
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.55, 0.27, 0.07, 1)

[node name="CashLabel" type="Label" parent="Panel/VBox"]
text = "💰 Cash: $0"
theme_override_font_sizes/font_size = 12

[node name="PackageLabel" type="Label" parent="Panel/VBox"]
text = "📫 Packages: 0"
theme_override_font_sizes/font_size = 12

[node name="DayLabel" type="Label" parent="Panel/VBox"]
text = "📅 Day 1"
theme_override_font_sizes/font_size = 12

[node name="StatusPanel" type="PanelContainer" parent="."]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -160
offset_right = -8
offset_bottom = 60

[node name="VBox" type="VBoxContainer" parent="StatusPanel"]
layout_mode = 2

[node name="ModeLabel" type="Label" parent="StatusPanel/VBox"]
text = "🚶 On Foot"
theme_override_font_sizes/font_size = 12

[node name="SpeedLabel" type="Label" parent="StatusPanel/VBox"]
text = "Speed: 0.0"
theme_override_font_sizes/font_size = 12

[node name="MessageBox" type="PanelContainer" parent="."]
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -180
offset_top = -50
offset_right = 180
offset_bottom = -10
visible = false

[node name="MsgLabel" type="Label" parent="MessageBox"]
layout_mode = 2
text = ""
horizontal_alignment = 1
theme_override_font_sizes/font_size = 13

[node name="MessageTimer" type="Timer" parent="."]
one_shot = true

[connection signal="timeout" from="MessageTimer" to="." method="_on_msg_timer_timeout"]
